{
  "name": "anh-ot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:worker": "wrangler deploy --dry-run --env production --config wrangler-worker.toml",
    "lint": "oxlint",
    "preview": "vite preview",
    "cf:login": "wrangler login",
    "cf:deploy:pages": "wrangler pages deploy dist --project-name=chupgibaygio",
    "cf:deploy:worker": "wrangler deploy --env production --config wrangler-worker.toml",
    "cf:deploy:worker:dev": "wrangler deploy --env dev --config wrangler-worker.toml",
    "cf:d1:create": "wrangler d1 create chupgibaygio-db --config wrangler-worker.toml",
    "cf:d1:migrate": "wrangler d1 migrations apply chupgibaygio-db --env production --config wrangler-worker.toml",
    "cf:d1:migrate:dev": "wrangler d1 migrations apply chupgibaygio-db-dev --env dev --config wrangler-worker.toml",
    "cf:r2:create": "wrangler r2 bucket create chupgibaygio-assets --config wrangler-worker.toml",
    "cf:kv:create": "wrangler kv:namespace create CACHE --config wrangler-worker.toml"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.6",
    "hono": "^4.6.0",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "read-excel-file": "^9.3.12",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^3.80.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
